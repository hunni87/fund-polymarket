# 이 파일을 .env 로 복사해서 쓴다. .env 는 절대 커밋하지 않는다.

# --- 앱 ---
APP_ENV=local
DEBUG=true
SECRET_KEY=바꿔주세요-최소-32자-이상의-임의-문자열
CORS_ORIGINS=http://localhost:5173

# --- DB ---
DATABASE_URL=postgresql+psycopg://fund:fund@localhost:5432/fund

# --- 예측시장 파라미터 ---
INITIAL_POINTS=1000          # 신규 스터디원 초기 포인트
RAKE_BPS=0                   # 정산 수수료(bp). 0 = 수수료 없음
MIN_STAKE=1
MAX_STAKE_RATIO=0.5          # 한 마켓에 걸 수 있는 최대 비율(보유 포인트 대비)
DEFAULT_HORIZON_DAYS=5
DEFAULT_BUY_THRESHOLD_PCT=3.0
DEFAULT_SELL_THRESHOLD_PCT=-3.0
EXECUTION_MIN_PROBABILITY=0.55   # 1등 확률이 이 미만이면 주문하지 않음
QUORUM_RATIO=0.66                # 9명 중 6명 이상 참여해야 집행 대상

# --- 리스크 가드 (실제로 돈이 나가기 전 마지막 방어선) ---
MAX_ORDER_AMOUNT_KRW=1000000
MAX_DAILY_ORDERS=10
MAX_POSITION_WEIGHT=0.30
KILL_SWITCH=false            # true 면 어떤 주문도 브로커로 나가지 않음
ENFORCE_MARKET_HOURS=true    # 장 운영시간 밖 주문 사전 차단 (휴장일은 판단 못함)

# --- 브로커 ---
# mock: 네트워크 호출 없이 체결 시뮬레이션 (개발 기본값)
# kis:  한국투자증권 Open API 사용
BROKER_BACKEND=mock

# --- 한국투자증권 ---
# paper = 모의투자, live = 실계좌
KIS_ENV=paper
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=          # 계좌번호 앞 8자리 (CANO)
KIS_ACCOUNT_PROD_CD=01   # 계좌상품코드 (ACNT_PRDT_CD)
KIS_TOKEN_CACHE_PATH=.cache/kis_token.json

# 실계좌 주문 마스터 스위치. KIS_ENV=live 와 함께 true 여야만 실전 도메인에 붙는다.
ALLOW_LIVE_TRADING=false

# KIS가 거래ID를 개편하면 여기서 덮어쓴다. 실전 값만 지정하면 모의 값(V로 시작)은
# 자동 파생된다 — 자세한 내용은 backend/app/brokers/kis/constants.py 참고.
# KIS_TR_ID_ORDER_BUY=TTTC0802U
# KIS_TR_ID_ORDER_SELL=TTTC0801U
# KIS_TR_ID_BALANCE=TTTC8434R

# --- 스케줄러 ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
